# Host-only import and arithmetic reference. No family defaults or device work are enabled.
add_library(strix_gemma4_contracts INTERFACE)
target_include_directories(strix_gemma4_contracts INTERFACE src include)
target_compile_features(strix_gemma4_contracts INTERFACE cxx_std_20)
if(MSVC)
    target_compile_options(strix_gemma4_contracts INTERFACE /fp:strict /permissive- /Zc:__cplusplus /utf-8)
else()
    target_compile_options(strix_gemma4_contracts INTERFACE -fno-fast-math -ffp-contract=off -frounding-math)
endif()
add_library(strix_gemma4_model STATIC src/gemma4/model/manifest.cpp src/gemma4/model/safetensors.cpp
    src/gemma4/model/gguf.cpp src/gguf_reader.cpp src/model_content_hash.cpp src/model_runtime_binding.cpp src/serve/json.cpp)
target_link_libraries(strix_gemma4_model PUBLIC strix_gemma4_contracts Threads::Threads)
strix_target_warnings(strix_gemma4_model)
add_library(strix_gemma4_description STATIC src/gemma4/model/description.cpp)
target_link_libraries(strix_gemma4_description PUBLIC strix_gemma4_contracts strix_model_description)
strix_target_warnings(strix_gemma4_description)
add_executable(strix-gemma4-export-description src/gemma4/model/export_description_main.cpp)
target_link_libraries(strix-gemma4-export-description PRIVATE strix_gemma4_description)
strix_target_warnings(strix-gemma4-export-description)
add_library(strix_gemma4_ref STATIC src/gemma4/ref/target.cpp src/gemma4/ref/npz.cpp)
target_link_libraries(strix_gemma4_ref PUBLIC strix_gemma4_model)
strix_target_warnings(strix_gemma4_ref)
if(MSVC)
    target_compile_definitions(strix_gemma4_ref PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
add_executable(strix-gemma4-host-ref src/gemma4/ref/host_ref_main.cpp)
target_link_libraries(strix-gemma4-host-ref PRIVATE strix_gemma4_ref)
strix_target_warnings(strix-gemma4-host-ref)
if(BUILD_TESTING)
    add_executable(strix-gemma4-description-tests tests/gemma4_host/description.cpp)
    target_link_libraries(strix-gemma4-description-tests PRIVATE strix_gemma4_description)
    target_compile_definitions(strix-gemma4-description-tests PRIVATE
        G4_DESCRIPTION_FILE="${CMAKE_CURRENT_SOURCE_DIR}/models/nemotron-3.5-bolt-e4b.toml")
    strix_target_warnings(strix-gemma4-description-tests)
    add_test(NAME strix-gemma4-description-tests COMMAND strix-gemma4-description-tests)
    set_tests_properties(strix-gemma4-description-tests PROPERTIES TIMEOUT 60)
    foreach(part ops manifest rows npz)
        add_executable(strix-gemma4-${part}-tests tests/gemma4_host/${part}.cpp)
        target_link_libraries(strix-gemma4-${part}-tests PRIVATE strix_gemma4_ref)
        target_compile_definitions(strix-gemma4-${part}-tests PRIVATE G4_FIXTURE_DIR="${CMAKE_CURRENT_SOURCE_DIR}/tests/gemma4_host/fixtures")
        strix_target_warnings(strix-gemma4-${part}-tests)
        add_test(NAME strix-gemma4-${part}-tests COMMAND strix-gemma4-${part}-tests)
        set_tests_properties(strix-gemma4-${part}-tests PROPERTIES TIMEOUT 60)
    endforeach()
endif()
